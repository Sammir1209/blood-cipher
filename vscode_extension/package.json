{
  "name": "coder-kali-vscode",
  "displayName": "Coder-Kali: AI Cybersecurity & DevOps Assistant",
  "description": "Puente visual de VS Code para interactuar con el agente Coder-Kali en Linux.",
  "version": "1.0.0",
  "publisher": "coder-kali",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other",
    "Security"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coder-kali.openChat",
        "title": "Coder-Kali: Abrir Terminal de Chat Interactiva",
        "icon": "$(terminal)"
      },
      {
        "command": "coder-kali.auditFile",
        "title": "Coder-Kali: Auditar Archivo Actual con IA",
        "icon": "$(shield)"
      },
      {
        "command": "coder-kali.openConfig",
        "title": "Coder-Kali: Configurar Modelos y API Keys",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "coder-kali.auditFile",
          "group": "coder-kali@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
