{
  "name": "blood-cipher-vscode",
  "displayName": "Blood-Cipher: AI Hacktivism, OSINT & Security Assistant",
  "description": "Visual bridge for Blood-Cipher autonomous tactical AI agent in Linux.",
  "version": "1.5.0",
  "publisher": "blood-cipher",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other",
    "Security"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blood-cipher.openChat",
        "title": "Blood-Cipher: Abrir Terminal de Chat Interactiva",
        "icon": "$(terminal)"
      },
      {
        "command": "blood-cipher.auditFile",
        "title": "Blood-Cipher: Auditar Archivo Actual con IA",
        "icon": "$(shield)"
      },
      {
        "command": "blood-cipher.openConfig",
        "title": "Blood-Cipher: Configurar Modelos y API Keys",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "blood-cipher.auditFile",
          "group": "blood-cipher@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
